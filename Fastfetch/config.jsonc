{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
      "source": "C:/Path/to/your/ascii.txt",
      "type": "file",
      "color": {
          "1": "green"
      }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│ {#31} user    {#keys}│",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "│ {#32}󰇅 hname   {#keys}│",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "key": "│ {#33}󰅐 uptime  {#keys}│",
            "type": "uptime",
	    "format": "{2}h {3}m"         },
        {
            "key": "│ {#34}{icon} OS      {#keys}│",
            "type": "os",
	    "format": "{3} {12}"
        },
        {
            "key": "│ {#35} kernel  {#keys}│",
            "type": "kernel",
	    "format": "{2}"
        },
        {
            "key": "│ {#36}󰇄 desktop {#keys}│",
            "type": "de"
        },
        {
            "key": "│ {#31} term    {#keys}│",
            "type": "terminal",
            "format": "{5}"
        },
        {
            "key": "│ {#32} shell   {#keys}│",
            "type": "shell",
	    "format": "{6}"
        },
        {
            "key": "│ {#33}󰍛 cpu     {#keys}│",
            "type": "cpu",
            "showPeCoreCount": true,
            "format": "{1}"
        },
        {
            "key": "│ {#34}󰉉 disk    {#keys}│",
            "type": "disk",
            "folders": "/",
	    "format": "{1} / {2} ({3})"
        },
        {
            "key": "│ {#35} memory  {#keys}│",
            "type": "memory"
        },
        //{
        //    "key": "│ {#36}󰩟 network {#keys}│",
        //    "type": "localip",
        //    "format": "{ipv4} ({ifname})"
        //},
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#39} colors  {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}
